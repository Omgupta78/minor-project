# FaceID Attendance - configuration
#
# Copy to .env and edit. Nothing here is required to run locally, but the
# first two lines matter a lot on a real server.
# Never commit the filled-in .env: .gitignore already excludes it.

# ---------------------------------------------------------------- security
# Signs the login cookie. Without it a random key is generated at startup,
# which logs everybody out on every restart.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to 0 once your school's teachers have registered, so a public address
# stops accepting new accounts. The very first account is always allowed.
ALLOW_SIGNUP=1

# Send the session cookie only over HTTPS. Keep 1 in production.
# Set to 0 only for plain-http local testing, otherwise login will not stick.
COOKIE_SECURE=1

# PBKDF2 iterations for password hashing. Higher is safer and slower.
PASSWORD_ROUNDS=240000

# ---------------------------------------------------------------- storage
# Both of these MUST point at persistent storage on a hosting platform,
# or every deploy erases the attendance history and the enrolled faces.
ATTENDANCE_DB=/data/attendance.db
FACES_DIR=/data/faces

# ---------------------------------------------------------------- serving
HOST=0.0.0.0
PORT=8000
OPEN_BROWSER=0
FLASK_DEBUG=0
# Workers x threads for gunicorn. Leave blank to auto-size.
WEB_CONCURRENCY=
GUNICORN_TIMEOUT=300
LOG_LEVEL=info

# ---------------------------------------------------------------- uploads
MAX_PHOTOS_PER_SCAN=8
MAX_UPLOAD_MB=64
MAX_ENROL_PHOTOS=5

# ---------------------------------------------------------------- accuracy
# See readme.md "Recognition accuracy" before changing these.
MATCH_DISTANCE=0.50
REVIEW_DISTANCE=0.60
MATCH_MARGIN=0.06
FACE_MODEL=hog
FACE_UPSAMPLE=1
MAX_EDGE=1600
ENROL_JITTERS=10

# Photo quality gate at enrolment.
MIN_FACE_PX=80
MIN_SHARPNESS=25
MIN_BRIGHTNESS=45
MAX_BRIGHTNESS=225

# Back-row and small-face handling.
TILE_SCAN=auto
TILE_SIZE=1200
TILE_OVERLAP=240
SMALL_FACE_PX=110
UPSCALE_FACE_PX=150
MAX_UPSCALE=4.0
CROP_MARGIN=0.45
SMALL_FACE_JITTERS=2
SMALL_FACE_SLACK=0.06
SMALL_FACE_PENALTY=0.04
RESCUE_PASS=auto
RESCUE_UPSCALE=2.0
