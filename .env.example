# Security: generate with python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
PRODUCTION=0
# Closed by default; the first account can bootstrap an empty installation.
ALLOW_SIGNUP=0
COOKIE_SECURE=1
SESSION_HOURS=12
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=900
PASSWORD_ROUNDS=240000

ATTENDANCE_DB=/data/attendance.db
FACES_DIR=/data/faces
HOST=0.0.0.0
PORT=8000
OPEN_BROWSER=0
FLASK_DEBUG=0
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=300
LOG_LEVEL=info

MAX_PHOTOS_PER_SCAN=8
MAX_UPLOAD_MB=64
MAX_ENROL_PHOTOS=5
MATCH_DISTANCE=0.50
REVIEW_DISTANCE=0.60
MATCH_MARGIN=0.06
FACE_MODEL=hog
FACE_UPSAMPLE=1
MAX_EDGE=1600
ENROL_JITTERS=10
MIN_FACE_PX=80
MIN_SHARPNESS=25
MIN_BRIGHTNESS=45
MAX_BRIGHTNESS=225
TILE_SCAN=auto
TILE_SIZE=1200
TILE_OVERLAP=240
SMALL_FACE_PX=110
UPSCALE_FACE_PX=150
MAX_UPSCALE=4.0
CROP_MARGIN=0.45
SMALL_FACE_JITTERS=2
SMALL_FACE_SLACK=0.06
SMALL_FACE_PENALTY=0.04
RESCUE_PASS=auto
RESCUE_UPSCALE=2.0
